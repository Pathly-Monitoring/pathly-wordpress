{
  "name": "pathly/pathly-wordpress",
  "description": "Pathly plugin for WordPress and WooCommerce: Ping, Flow and Chain monitoring from the dashboard.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "homepage": "https://pathlyhq.com",
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "brain/monkey": "^2.6",
    "phpunit/phpunit": "^9.6",
    "squizlabs/php_codesniffer": "^3.10",
    "wp-coding-standards/wpcs": "^3.1",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
  },
  "config": {
    "platform": { "php": "7.4.33" },
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  },
  "scripts": {
    "lint": "phpcs",
    "format": "phpcbf",
    "test": "phpunit",
    "coverage": [
      "@php -d xdebug.mode=coverage vendor/bin/phpunit --path-coverage --coverage-text=build/coverage.txt --coverage-clover=build/clover.xml",
      "@php bin/check-coverage.php build/coverage.txt"
    ]
  }
}
